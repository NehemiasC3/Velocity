# Configuración del servidor Backend
PORT=3001
NODE_ENV=development

# Credenciales y Endpoint de Wispro Cloud API
WISPRO_API_URL=https://www.cloud.wispro.co/api/v1
WISPRO_API_TOKEN=tu-token-de-wispro-aqui

# Opcional: Tiempo de vida de la caché en milisegundos (predeterminado: 300000 = 5 min)
INVENTORY_CACHE_TTL_MS=300000
